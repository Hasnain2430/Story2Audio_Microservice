# Story2Audio v2 — environment contract.
#
# Copy to `.env` and fill in. `.env` is gitignored; no real secret belongs in this file.
# Every variable the stack reads is listed here, even the ones with defaults, so that
# `.env.example` is the single answer to "what does this service need to boot?".

# ─── Core ────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=local                  # local | staging | production
LOG_LEVEL=info                     # debug | info | warning | error
LOG_FORMAT=console                 # console (local) | json (deployed)

# ─── Gateway ─────────────────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# Comma-separated exact origins. Never "*" — the API uses cookie-based sessions.
CORS_ALLOW_ORIGINS=http://localhost:5173
# Signs the anonymous session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-generate-a-random-48-byte-value
PUBLIC_WEB_ORIGIN=http://localhost:5173

# ─── Postgres ────────────────────────────────────────────────────────────────────────
# Gateway uses the async driver, Celery workers use the sync one. Same database.
DATABASE_URL=postgresql+asyncpg://story2audio:story2audio@localhost:5432/story2audio
DATABASE_URL_SYNC=postgresql+psycopg://story2audio:story2audio@localhost:5432/story2audio

# ─── Redis (Celery broker + progress pub/sub + rate limits) ──────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Object storage (MinIO locally, Cloudflare R2 in production) ─────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=story2audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true           # true for MinIO, false for R2
PRESIGNED_URL_TTL_SECONDS=3600
AUDIO_RETENTION_DAYS=30

# ─── LLM provider (story-worker) ─────────────────────────────────────────────────────
# One model for every story length. v1 picked the model from the requested length, so a
# short story was forced onto a 1B model -- a deployment constraint leaking into product
# behaviour.
LLM_PROVIDER=ollama                # ollama | groq | fake
LLM_MODEL=llama3
LLM_TEMPERATURE=0.9
LLM_TOP_P=0.95
LLM_REQUEST_TIMEOUT_SECONDS=120

# LLM_PROVIDER=ollama  -- fully offline, no API key
OLLAMA_BASE_URL=http://localhost:11434

# LLM_PROVIDER=groq  -- OpenAI-compatible; the same adapter serves OpenRouter, Together
# or a self-hosted vLLM by changing the base URL.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── story-worker behaviour ──────────────────────────────────────────────────────────
# How often streamed text is forwarded. One frame per token would flood the socket
# without the text arriving any sooner.
TOKEN_BATCH_INTERVAL_SECONDS=0.05
TOKEN_BATCH_MAX_CHARS=400
# Cancellation is checked every N published frames: often enough to stop promptly, rare
# enough not to query the database for every word.
CANCEL_CHECK_EVERY_FRAMES=10
# At most one extra pass when a story stops mid-sentence. Bounded on purpose: a model
# that never lands an ending would otherwise be an open-ended bill.
MAX_CONTINUATION_PASSES=1

MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
RETRY_BACKOFF_MAX_SECONDS=120
# Advisory lease preventing two workers from paying the model for the same job. Must
# exceed the longest plausible generation.
JOB_LEASE_TTL_SECONDS=900

# ─── TTS provider ────────────────────────────────────────────────────────────────────
# grpc     → self-hosted tts-engine (local GPU, or a serverless-GPU endpoint)
# hosted   → a third-party cloning API
# cpu      → small CPU model; no voice cloning. CI and degraded-demo only.
TTS_PROVIDER=grpc
TTS_ENGINE_ADDRESS=localhost:50051
TTS_REQUEST_TIMEOUT_SECONDS=600
HOSTED_TTS_API_KEY=

# ─── tts-engine (read only by that service) ──────────────────────────────────────────
TTS_ENGINE_HOST=0.0.0.0
TTS_ENGINE_PORT=50051
# xtts renders speech and needs a GPU. stub renders a tone, not speech: it exists so the
# service, the streaming protocol and the whole worker pipeline can be exercised without
# one, and it is refused outright when ENVIRONMENT=production.
TTS_BACKEND=stub                   # xtts | stub
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cuda                    # cuda | cpu
# One GPU, one inference. Excess demand is refused with RESOURCE_EXHAUSTED rather than
# queued: v1's global mutex queued callers invisibly and without bound.
TTS_MAX_CONCURRENT_INFERENCES=1
GRPC_MAX_WORKERS=8
# Speaker embeddings are cached by voice id. v1 recomputed the conditioning latents from
# the reference WAV on every single segment.
SPEAKER_CACHE_SIZE=64
# PCM per streamed chunk, kept far below gRPC's 4 MB default so no limit override is
# needed anywhere -- that override is exactly what v1 required.
AUDIO_CHUNK_BYTES=32768
SHUTDOWN_GRACE_SECONDS=30
COQUI_TOS_AGREED=1

# ─── Quotas and spend guardrails (enforced in code, not just in billing) ─────────────
RATE_LIMIT_JOBS_PER_HOUR=10
RATE_LIMIT_UPLOADS_PER_HOUR=5
MAX_CONCURRENT_JOBS_PER_SESSION=2
GLOBAL_DAILY_JOB_CAP=200           # hard stop; POST /v1/jobs returns 429 past this
MAX_PROMPT_CHARS=2000
MAX_VOICE_UPLOAD_BYTES=10485760    # 10 MiB
MIN_VOICE_DURATION_SECONDS=6
MAX_VOICE_DURATION_SECONDS=120

# ─── Frontend (Vite; only VITE_-prefixed vars reach the browser bundle) ──────────────
VITE_API_ORIGIN=http://localhost:8000
