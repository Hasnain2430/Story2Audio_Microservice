# Story2Audio v2 — environment contract.
#
# Copy to `.env` and fill in. `.env` is gitignored; no real secret belongs in this file.
# Every variable the stack reads is listed here, even the ones with defaults, so that
# `.env.example` is the single answer to "what does this service need to boot?".

# ─── Core ────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=local                  # local | staging | production
LOG_LEVEL=info                     # debug | info | warning | error
LOG_FORMAT=console                 # console (local) | json (deployed)

# ─── Gateway ─────────────────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# Comma-separated exact origins. Never "*" — the API uses cookie-based sessions.
CORS_ALLOW_ORIGINS=http://localhost:5173
# Signs the anonymous session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-generate-a-random-48-byte-value
PUBLIC_WEB_ORIGIN=http://localhost:5173

# ─── Postgres ────────────────────────────────────────────────────────────────────────
# Gateway uses the async driver, Celery workers use the sync one. Same database.
DATABASE_URL=postgresql+asyncpg://story2audio:story2audio@localhost:5432/story2audio
DATABASE_URL_SYNC=postgresql+psycopg://story2audio:story2audio@localhost:5432/story2audio

# ─── Redis (Celery broker + progress pub/sub + rate limits) ──────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Object storage (MinIO locally, Cloudflare R2 in production) ─────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=story2audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true           # true for MinIO, false for R2
PRESIGNED_URL_TTL_SECONDS=3600
AUDIO_RETENTION_DAYS=30

# ─── LLM provider ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama                # ollama | groq
LLM_MODEL=llama3
LLM_TEMPERATURE=0.9
LLM_TOP_P=0.95
LLM_REQUEST_TIMEOUT_SECONDS=120

# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# LLM_PROVIDER=groq  (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── TTS provider ────────────────────────────────────────────────────────────────────
# grpc     → self-hosted tts-engine (local GPU, or a serverless-GPU endpoint)
# hosted   → a third-party cloning API
# cpu      → small CPU model; no voice cloning. CI and degraded-demo only.
TTS_PROVIDER=grpc
TTS_ENGINE_ADDRESS=localhost:50051
TTS_REQUEST_TIMEOUT_SECONDS=600
HOSTED_TTS_API_KEY=

# ─── tts-engine (read only by that service) ──────────────────────────────────────────
TTS_ENGINE_PORT=50051
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cuda                    # cuda | cpu
TTS_MAX_CONCURRENT_INFERENCES=1    # one GPU, one inference; excess gets RESOURCE_EXHAUSTED
COQUI_TOS_AGREED=1

# ─── Quotas and spend guardrails (enforced in code, not just in billing) ─────────────
RATE_LIMIT_JOBS_PER_HOUR=10
RATE_LIMIT_UPLOADS_PER_HOUR=5
MAX_CONCURRENT_JOBS_PER_SESSION=2
GLOBAL_DAILY_JOB_CAP=200           # hard stop; POST /v1/jobs returns 429 past this
MAX_PROMPT_CHARS=2000
MAX_VOICE_UPLOAD_BYTES=10485760    # 10 MiB
MIN_VOICE_DURATION_SECONDS=6
MAX_VOICE_DURATION_SECONDS=120

# ─── Frontend (Vite; only VITE_-prefixed vars reach the browser bundle) ──────────────
VITE_API_ORIGIN=http://localhost:8000
