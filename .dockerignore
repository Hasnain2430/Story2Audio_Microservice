# Each service image copies only what it needs; this is the shared floor.

.git/
.github/
.gitignore

# The v1 system. Kept in the repo for reference and benchmarking, never shipped.
legacy/
docs/

# Local environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
node_modules/
dist/

# Secrets
.env
.env.*
!.env.example

# Tests and fixtures are not part of any runtime image
tests/

# Model weights are mounted or downloaded at runtime, never baked in
*.pth
*.pt
*.ckpt
models/

# Local runtime artifacts
output/
tmp/
*.log
