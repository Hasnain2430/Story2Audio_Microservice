# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/

# Environment — never commit real secrets. See .env.example for the contract.
.env
.env.*
!.env.example

# Generated protobuf stubs (regenerated by the build; see infra/scripts/gen-proto)
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi
!legacy/proto/*_pb2.py
!legacy/proto/*_pb2_grpc.py

# Model weights and other large binaries pulled at runtime
*.pth
*.pt
*.ckpt
models/
!legacy/xtts_model/*.pth

# Local runtime artifacts
output/
tmp/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
