# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/

# Environment — never commit real secrets. See .env.example for the contract.
.env
.env.*
!.env.example

# Generated protobuf stubs. The .proto is the source of truth; stubs are produced by
# `make proto` (infra/scripts/gen_proto.py) so a stale copy cannot drift from it.
services/*/src/*/pb/
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi
!legacy/proto/*_pb2.py
!legacy/proto/*_pb2_grpc.py

# Model weights and other large binaries pulled at runtime
*.pth
*.pt
*.ckpt
models/
!legacy/xtts_model/*.pth

# Local runtime artifacts
output/
tmp/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Isolated venv for running tts-engine natively on the GPU (see docs/03 Phase 4).
# Kept out of the uv workspace so CUDA torch wheels never enter the shared lockfile.
.venv-tts-gpu/

# Planning notes for the rebuild. Kept locally, deliberately not published.
docs/_planning/
